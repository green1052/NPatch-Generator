{
    "outputDir": "build",
    "jarCacheDir": "bin",
    "npatchVersion": "latest",
    "apkeditorVersion": "latest",
    "bcVersion": "latest",
    "concurrency": 1,
    "apps": [
        {
            "packageName": "com.discord",
            "arch": "arm64-v8a",
            "npatchArgs": {
                "sigbypassLevel": 0
            },
            "sources": [
                {
                    "type": "vendetta",
                    "url": "https://tracker.vendetta.rocks"
                }
            ]
        },
        {
            "packageName": "com.dcinside.app.android",
            "sources": [
                {
                    "type": "uptodown",
                    "url": "https://dcinside.en.uptodown.com/android"
                }
            ]
        },
        {
            "packageName": "com.novelpia.android.me",
            "sources": [
                {
                    "type": "uptodown",
                    "url": "https://com-novelpia-android-me.en.uptodown.com/android"
                }
            ]
        }
    ]
}
